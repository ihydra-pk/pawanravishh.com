---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head><BaseHead title="Notes | Pawankumar Ravish" description="Upcoming notes on AI, software engineering, CRM, and the process of learning in public." /></head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Writing in public</p>
			<h1>Notes from the workbench.</h1>
			<p>I’m building a home here for practical notes on AI, software engineering, Salesforce, developer tools, and the lessons that emerge while learning by building.</p>
			<div class="coming"><span>01</span><div><h2>First posts are on the way.</h2><p>Expect concise write-ups as I explore Machine Learning, Agentic Software Engineering, and thoughtful ways to apply AI in real systems.</p></div></div>
			<a href={base}>← Back to portfolio</a>
		</main>
		<Footer />
	</body>
</html>

<style>
main{max-width:820px;padding:7rem 0;width:calc(100% - 3rem)}.eyebrow{color:var(--muted);font-size:.8rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}h1{font-size:clamp(3rem,7vw,5.5rem);letter-spacing:-.07em;line-height:.98;margin:.7rem 0 1.8rem}main>p:not(.eyebrow){color:var(--text);font-size:1.25rem;line-height:1.65;max-width:680px}.coming{align-items:flex-start;border-bottom:1px solid var(--border);border-top:2px solid var(--ink);display:flex;gap:2rem;margin:4rem 0 2rem;padding:1.5rem 0 2rem}.coming>span{color:var(--brand);font-size:1rem;font-weight:700}.coming h2{font-size:1.7rem;margin:0}.coming p{color:var(--muted);line-height:1.6}a{color:var(--brand);font-weight:700;text-decoration:none}a:hover{text-decoration:underline}@media(max-width:720px){main{padding:4rem 0;width:calc(100% - 2rem)}}
</style>
