---
const navigation = [
	{ href: '/#about', label: 'About' },
	{ href: '/#experience', label: 'Experience' },
	{ href: '/#skills', label: 'Skills' },
	{ href: '/blog', label: 'Notes' },
];
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href="/" aria-label="Pawan Ravish, home">
			<span class="monogram" aria-hidden="true"><img src="/pr-monogram.svg" alt="" /></span>
			<span class="wordmark"><strong>Pawan</strong><em>Ravish</em><b aria-hidden="true">.</b></span>
		</a>
		<div class="nav-links">
			{navigation.map((item) => <a href={item.href}>{item.label}</a>)}
		</div>
		<a class="contact" href="mailto:ravishpawan10@gmail.com"><span>Let’s connect</span><b aria-hidden="true">↗</b></a>
	</nav>
</header>

<style>
	header{background:rgba(255,255,255,.78);border-bottom:1px solid rgba(201,213,216,.78);backdrop-filter:blur(16px);position:sticky;top:0;z-index:10}nav{align-items:center;column-gap:clamp(1.5rem,4vw,4.5rem);display:grid;grid-template-columns:1fr auto 1fr;margin:auto;max-width:1120px;min-height:82px;width:calc(100% - 3rem)}.brand{align-items:center;color:#172a3a;display:flex;gap:.78rem;justify-self:start;text-decoration:none}.monogram{display:inline-flex;height:48px;transition:filter .25s ease,transform .25s ease;width:40px}.monogram img{display:block;height:100%;width:100%}.brand:hover .monogram{filter:drop-shadow(3px 4px 5px rgba(214,90,49,.2));transform:translateY(-2px)}.wordmark{align-items:baseline;display:flex;font-size:1.28rem;letter-spacing:-.075em;line-height:1}.wordmark strong{font-weight:700}.wordmark em{color:#d65a31;font-family:Georgia,serif;font-size:1.22em;font-style:italic;font-weight:400;letter-spacing:-.1em;margin-left:.15rem}.wordmark>b{color:#d65a31;font-size:1.35em;line-height:.45;margin-left:.04rem}.nav-links{display:flex;gap:1.8rem;justify-self:center}.nav-links a{color:#52606d;font-size:.96rem;font-weight:700;padding:.35rem 0;position:relative;text-decoration:none;transition:color .22s ease}.nav-links a::after{background:#d65a31;bottom:.1rem;content:"";height:2px;left:0;position:absolute;transform:scaleX(0);transform-origin:right;transition:transform .25s ease;width:100%}.nav-links a:hover{color:#172a3a}.nav-links a:hover::after{transform:scaleX(1);transform-origin:left}.contact{align-items:center;background:#172a3a;border-radius:100px;color:white;display:flex;font-size:.84rem;font-weight:700;gap:.42rem;justify-self:end;padding:.64rem .9rem;text-decoration:none;transition:background .22s ease,transform .22s ease}.contact b{color:#f6b6a4;font-size:1.08rem;line-height:.8}.contact:hover{background:#d65a31;color:white;transform:translateY(-2px)}.contact:hover b{color:white}@media(max-width:720px){nav{column-gap:1rem;grid-template-columns:1fr auto;min-height:74px;width:calc(100% - 2rem)}.wordmark{font-size:1.12rem}.nav-links{display:none}.contact{font-size:.8rem;padding:.58rem .72rem}.monogram{height:42px;width:35px}}
</style>
