---
const navigation = [
	{ href: '#about', label: 'About' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#skills', label: 'Skills' },
	{ href: 'blog', label: 'Notes' },
];
const base = `${import.meta.env.BASE_URL}/`;
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href={base} aria-label="Pawan Ravish, home">
			<span class="monogram" aria-hidden="true"><img src={`${base}pr-monogram.svg`} alt="" /></span>
			<span class="wordmark"><strong>Pawan</strong><em>Ravish</em><b aria-hidden="true">.</b></span>
		</a>
		<div class="nav-links">
			{navigation.map((item) => <a href={`${base}${item.href}`}>{item.label}</a>)}
		</div>
		<div class="nav-end">
			<button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
				<span class="knob" aria-hidden="true">
					<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
					<svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z" /></svg>
				</span>
			</button>
			<a class="contact" href="mailto:ravishpawan10@gmail.com"><span>Let’s connect</span><b aria-hidden="true">↗</b></a>
		</div>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

	const apply = (theme: 'light' | 'dark') => {
		root.dataset.theme = theme;
		toggle?.setAttribute('aria-checked', String(theme === 'dark'));
	};

	const saved = () => {
		try {
			return localStorage.getItem('theme');
		} catch {
			return null;
		}
	};

	apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

	toggle?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		apply(next);
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});

	// Keep other open tabs in sync.
	window.addEventListener('storage', (event) => {
		if (event.key === 'theme' && (event.newValue === 'light' || event.newValue === 'dark')) {
			apply(event.newValue);
		}
	});

	// Follow OS changes until the user picks a theme explicitly.
	systemDark.addEventListener('change', (event) => {
		if (!saved()) apply(event.matches ? 'dark' : 'light');
	});
</script>

<style>
	header{background:var(--header-bg);border-bottom:1px solid var(--header-border);backdrop-filter:blur(16px);position:sticky;top:0;z-index:10}nav{align-items:center;column-gap:clamp(1.5rem,4vw,4.5rem);display:grid;grid-template-columns:1fr auto 1fr;margin:auto;max-width:1120px;min-height:82px;width:calc(100% - 3rem)}.brand{align-items:center;color:var(--ink);display:flex;gap:.78rem;justify-self:start;text-decoration:none}.monogram{display:inline-flex;height:48px;transition:filter .25s ease,transform .25s ease;width:40px}.monogram img{display:block;height:100%;width:100%}.brand:hover .monogram{filter:drop-shadow(3px 4px 5px rgba(214,90,49,.2));transform:translateY(-2px)}.wordmark{align-items:baseline;display:flex;font-size:1.28rem;letter-spacing:-.075em;line-height:1}.wordmark strong{font-weight:700}.wordmark em{color:var(--brand);font-family:Georgia,serif;font-size:1.22em;font-style:italic;font-weight:400;letter-spacing:-.1em;margin-left:.15rem}.wordmark>b{color:var(--brand);font-size:1.35em;line-height:.45;margin-left:.04rem}.nav-links{display:flex;gap:1.8rem;justify-self:center}.nav-links a{color:var(--muted);font-size:.96rem;font-weight:700;padding:.35rem 0;position:relative;text-decoration:none;transition:color .22s ease}.nav-links a::after{background:var(--brand);bottom:.1rem;content:"";height:2px;left:0;position:absolute;transform:scaleX(0);transform-origin:right;transition:transform .25s ease;width:100%}.nav-links a:hover{color:var(--ink)}.nav-links a:hover::after{transform:scaleX(1);transform-origin:left}.contact{align-items:center;background:var(--btn-bg);border-radius:100px;color:var(--btn-fg);display:flex;font-size:.84rem;font-weight:700;gap:.42rem;padding:.64rem .9rem;text-decoration:none;transition:background .22s ease,transform .22s ease}.contact b{color:var(--contact-arrow);font-size:1.08rem;line-height:.8}.contact:hover{background:var(--brand-fill);color:white;transform:translateY(-2px)}.contact:hover b{color:white}@media(max-width:720px){nav{column-gap:1rem;grid-template-columns:1fr auto;min-height:74px;width:calc(100% - 2rem)}.wordmark{font-size:1.12rem}.nav-links{display:none}.contact{font-size:.8rem;padding:.58rem .72rem}.monogram{height:42px;width:35px}}
</style>

<style>
	.nav-end{align-items:center;display:flex;gap:.75rem;justify-self:end}
	.theme-toggle{background:var(--chip);border:1px solid var(--border-tint);border-radius:100px;cursor:pointer;flex:none;height:30px;padding:0;position:relative;transition:background .22s ease,border-color .22s ease;width:54px}
	.theme-toggle:hover{border-color:var(--border-hover)}
	.theme-toggle:focus-visible{outline:2px solid var(--brand);outline-offset:3px}
	.knob{align-items:center;background:var(--surface);border-radius:50%;box-shadow:0 2px 6px var(--shadow);color:var(--brand);display:flex;height:22px;justify-content:center;left:3px;position:absolute;top:3px;transition:transform .22s ease;width:22px}
	.knob svg{height:14px;width:14px}
	.icon-moon{display:none}
	:global(:root[data-theme='dark']) .knob{transform:translateX(24px)}
	:global(:root[data-theme='dark']) .icon-sun{display:none}
	:global(:root[data-theme='dark']) .icon-moon{display:block}
	:global([data-theme='dark']) .monogram img{filter:drop-shadow(0 0 .6px var(--border-hover)) drop-shadow(0 0 .6px var(--border-hover))}
	@media(max-width:720px){.nav-end{gap:.5rem}}
	@media(prefers-reduced-motion:reduce){.theme-toggle,.knob{transition:none}}
</style>
